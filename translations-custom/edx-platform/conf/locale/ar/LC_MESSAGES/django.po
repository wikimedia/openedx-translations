#: lms/djangoapps/instructor/views/api.py:1428
msgid "Certificate link"
msgstr "رابط الشهادة"

#: openedx/core/djangoapps/user_api/accounts/__init__.py:43
msgid "Usernames must not contain the following symbols: #, <, >, [, ], |, {, }, /, \\, :, @"
msgstr "يجب ألا تحتوي أسماء المستخدمين على الرموز التالية: #، <، >، [، ]، |، {، }، /، \\، :، @"

#: xmodule/course_block.py:1056
msgid "Select Course Font Family"
msgstr "اختر عائلة خط الدورة"

#: xmodule/course_block.py:1058
msgid "\n            Select course family in which you want to display your course.\n            Available options are \"font-trebuchet\", \"font-open-sans\", \"font-noto-kufi-arabic\", \"font-montserrat\", and \"font-source-sans-pro\".\n            If value is invalid or empty the default font-family will be \"Helvetica Neue\".\n            "
msgstr "\nاختر نوع الخط الذي ترغب في عرض دورتك به.\n\nالخيارات المتاحة هي: \"font-trebuchet\"، \"font-open-sans\"، \"font-noto-kufi-arabic\"، \"font-montserrat\"، و\"font-source-sans-pro\".\n\nإذا كانت القيمة غير صالحة أو فارغة، فسيكون نوع الخط الافتراضي هو \"Helvetica Neue\"."

#: xmodule/course_block.py:1068
msgid "Issue Open Badges"
msgstr "إصدار شارات مفتوحة"

#: xmodule/course_block.py:1070
msgid "Issue Open Badges badges for this course. Badges are generated when certificates are created."
msgstr "إصدار شارات Open Badges لهذه الدورة. يتم إنشاء الشارات عند إنشاء الشهادات."

#: lms/templates/instructor/instructor_dashboard_2/student_admin.html:21
msgid "Click to generate a CSV grade report for all currently enrolled students.!!"
msgstr "انقر هنا لإنشاء تقرير درجات بصيغة CSV لجميع الطلاب المسجلين حاليًا.!!"

